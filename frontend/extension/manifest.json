{
  "manifest_version": 3,
  "name": "TrustLens AI",
  "version": "1.0",
  "description": "AI Website Security Analyzer",

  "permissions": ["tabs", "activeTab", "scripting", "storage", "notifications"],
  "host_permissions": ["<all_urls>"],

  "icons": {
    "16": "icons/notification.svg",
    "128": "icons/notification.svg"
  },

  "action": {
    "default_popup": "popup.html"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}